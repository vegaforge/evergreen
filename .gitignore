/target
**/*.rs.bk
Cargo.lock.bak

# Soroban test snapshots are useful to commit; build artifacts are not.
**/target/

# Node (TypeScript bindings)
node_modules/
bindings/evergreen-js/dist/
*.tsbuildinfo

# Editor and OS noise
.DS_Store
.idea/
.vscode/

# Governance
# Every branch is checked out under .worktrees/.
.worktrees/
# Ship scripts prepared for the maintainer live at the root and are never
# committed. Root only: scripts/*.sh stays tracked.
/*.sh
.env*
!.env.example

# Python bytecode from scripts/security
__pycache__/
